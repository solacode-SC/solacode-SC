{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileData",
  "description": "Schema for profile rotation data and GitHub profile content",
  "type": "object",
  "required": [
    "rotation",
    "profile",
    "links",
    "pillars",
    "approach",
    "skills",
    "projects"
  ],
  "properties": {
    "rotation": {
      "type": "object",
      "required": ["interval_hours", "cron", "mode", "current_theme", "collection"],
      "properties": {
        "interval_hours": {
          "type": "number",
          "description": "Cycle duration in hours (e.g. 12)",
          "minimum": 1
        },
        "cron": {
          "type": "string",
          "description": "Standard cron expression corresponding to interval_hours"
        },
        "mode": {
          "type": "string",
          "enum": ["sequential", "random"]
        },
        "current_theme": {
          "type": "string",
          "description": "Name of the theme currently deployed to root"
        },
        "current_index": {
          "type": "integer",
          "minimum": 0
        },
        "last_rotated": {
          "type": "string",
          "description": "ISO timestamp of the last rotation"
        },
        "collection": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered list of theme directory names in other-profile/"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name", "handle", "role", "tagline", "about"],
      "properties": {
        "name": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "handle": { "type": "string" },
        "role": { "type": "string" },
        "headline": { "type": "string" },
        "tagline": { "type": "string" },
        "about": {
          "type": "array",
          "items": { "type": "string" }
        },
        "facts": { "type": "string" },
        "focus": { "type": "string" }
      }
    },
    "links": {
      "type": "object",
      "required": ["github", "linkedin", "portfolio"],
      "properties": {
        "github": { "type": "string", "format": "uri" },
        "linkedin": { "type": "string", "format": "uri" },
        "portfolio": { "type": "string", "format": "uri" },
        "portfolio_display": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "short", "category"],
        "properties": {
          "name": { "type": "string" },
          "short": { "type": "string" },
          "category": { "type": "string" },
          "badge": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "repo_slug", "repo_url", "live_url", "display_url", "description", "tags"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "string" },
          "title": { "type": "string" },
          "badge": { "type": "string" },
          "subtitle": { "type": "string" },
          "repo_slug": { "type": "string" },
          "repo_url": { "type": "string", "format": "uri" },
          "live_url": { "type": "string", "format": "uri" },
          "display_url": { "type": "string" },
          "description": { "type": "string" },
          "description_lines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "card_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "featured": { "type": "boolean" }
        }
      }
    }
  }
}
